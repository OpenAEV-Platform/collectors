### More env vars are defined in the example docker-compose.yml file
### with appropriate defaults.

# base URL to reach the OpenAEV server
# note this URL must be routable from inside the container
# so `localhost` will most likely not work
OPENAEV_URL=ChangeMe
# admin account API token from the OpenAEV server
OPENAEV_TOKEN=ChangeMe
# only required for multi-tenancy (Enterprise Edition), keep commented otherwise
#OPENAEV_TENANT_ID=ChangeMe

# collector ID must be a unique string, e.g. UUIDv4
COLLECTOR_ID=ChangeMe
COLLECTOR_NAME=Amazon Web Services
COLLECTOR_PERIOD=PT1H
COLLECTOR_LOG_LEVEL=error

COLLECTOR_AWS_AUTH_TYPE=credentials
COLLECTOR_AWS_ACCESS_KEY_ID=ChangeMe
COLLECTOR_AWS_SECRET_ACCESS_KEY=ChangeMe
COLLECTOR_AWS_SESSION_TOKEN=ChangeMe
COLLECTOR_AWS_ASSUME_ROLE_ARN=ChangeMe
COLLECTOR_AWS_REGIONS=ChangeMe

### IAM Roles Anywhere (only when COLLECTOR_AWS_AUTH_TYPE=roles_anywhere)
#COLLECTOR_AWS_ROLES_ANYWHERE_TRUST_ANCHOR_ARN=arn:aws:rolesanywhere:eu-west-1:123456789012:trust-anchor/ChangeMe
#COLLECTOR_AWS_ROLES_ANYWHERE_PROFILE_ARN=arn:aws:rolesanywhere:eu-west-1:123456789012:profile/ChangeMe
#COLLECTOR_AWS_ROLES_ANYWHERE_ROLE_ARN=arn:aws:iam::123456789012:role/ChangeMe
#COLLECTOR_AWS_ROLES_ANYWHERE_CERTIFICATE="-----BEGIN CERTIFICATE-----\nChangeMe\n-----END CERTIFICATE-----"
#COLLECTOR_AWS_ROLES_ANYWHERE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nChangeMe\n-----END PRIVATE KEY-----"
#COLLECTOR_AWS_ROLES_ANYWHERE_CERTIFICATE_CHAIN=
#COLLECTOR_AWS_ROLES_ANYWHERE_PRIVATE_KEY_PASSPHRASE=
#COLLECTOR_AWS_ROLES_ANYWHERE_REGION=
#COLLECTOR_AWS_ROLES_ANYWHERE_SESSION_DURATION=3600
