### More env vars are defined in the example docker-compose.yml file
### with appropriate defaults.

# base URL to reach the OpenAEV server
# note this URL must be routable from inside the container
# so `localhost` will most likely not work
OPENAEV_URL=ChangeMe
# admin account API token from the OpenAEV server
OPENAEV_TOKEN=ChangeMe
# only required for multi-tenancy (Enterprise Edition), keep commented otherwise
#OPENAEV_TENANT_ID=ChangeMe

# collector ID must be a unique string, e.g. UUIDv4
COLLECTOR_ID=ChangeMe
COLLECTOR_NAME=GitHub
COLLECTOR_PERIOD=PT6H
COLLECTOR_LOG_LEVEL=error

# Read-only token (fine-grained: Metadata, Actions and Packages read)
COLLECTOR_GITHUB_TOKEN=ChangeMe
# GitHub Enterprise Server: https://github.example.com/api/v3
COLLECTOR_GITHUB_API_URL=https://api.github.com

# Owners to collect (at least one)
COLLECTOR_GITHUB_ORGANIZATIONS=ChangeMe
#COLLECTOR_GITHUB_USERS=

# What to collect
COLLECTOR_GITHUB_INCLUDE_ARCHIVED=true
COLLECTOR_GITHUB_INCLUDE_FORKS=false
COLLECTOR_GITHUB_COLLECT_WORKFLOWS=true
COLLECTOR_GITHUB_COLLECT_PACKAGES=true
COLLECTOR_GITHUB_PACKAGE_TYPES=npm,maven,rubygems,nuget,container
COLLECTOR_GITHUB_END_DATE_REMOVED=true
# tag | end_date | delete
COLLECTOR_GITHUB_REMOVED_ACTION=end_date
