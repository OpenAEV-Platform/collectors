openaev:
  url: "http://change.me"
  token: "ChangeMe"
  # only required for multi-tenancy (Enterprise Edition), keep commented otherwise
  # tenant_id: "ChangeMe"

collector:
  id: "ChangeMe"
  name: 'Splunk ES'
  platform: 'SIEM'
  period: 'PT1M'
  log_level: 'error'

splunk_es:
  # Splunk REST/management API endpoint - port 8089 (NOT the web UI on 8000/443,
  # which returns HTTP 404 for search API calls). Splunk Cloud uses a dedicated
  # API host (e.g. https://<stack>.splunkcloud.com:8089).
  base_url: "https://splunk.company.com:8089"
  username: "ChangeMe"
  password: "ChangeMe"
  alerts_index: "notable"
  max_retry: 5
  offset: 120
  # LOGGING expectations: search raw-event indexes (not the notable index).
  # Off by default; the indexes are required when it is on.
  # logging_enabled: true
  # logging_indexes: "sysmon,wineventlog"
  # Optional: replace the built-in Logging search. Placeholders: {indexes},
  # {earliest}, {latest}, {terms}, {source_ips}, {target_ips}. Must include
  # '| table _time, index, _raw'.
  # logging_query_template: "search index IN ({indexes}) sourcetype=XmlWinEventLog* earliest={earliest} latest={latest} ({terms}) | table _time, index, host, sourcetype, _raw"
  # Longest time between two Logging searches of the same expectation (at most
  # PT1H). Searches start every collector period and back off while nothing is found.
  # logging_max_interval: 'PT15M'
  # Signature matching happens after the fetch (raw-text regex on _raw); the
  # query only filters on IPs, hostnames, and the time window.
  # Allowed placeholders: {alerts_index}, {source_ips}, {target_ips},
  # {hostnames}, {start_date}, {end_date}.
  # query_template: "index={alerts_index} (src_ip IN ({source_ips}) OR src IN ({source_ips}) OR source_ip IN ({source_ips}) OR client_ip IN ({source_ips})) (dst_ip IN ({target_ips}) OR dest IN ({target_ips}) OR dest_ip IN ({target_ips}) OR destination_ip IN ({target_ips}) OR server_ip IN ({target_ips})) (host IN ({hostnames}) OR hostname IN ({hostnames}) OR host_name IN ({hostnames})) earliest={start_date} latest={end_date} | table _time, src_ip, src, source_ip, client_ip, dst_ip, dest, dest_ip, destination_ip, server_ip, host, hostname, signature, rule_name, event_type, severity, url_path, _raw | sort -_time"
