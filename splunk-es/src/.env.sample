### Copy this file to .env next to docker-compose.yml, which reads the
### collector settings from it. Settings left out keep the collector's defaults.

# base URL to reach the OpenAEV server
# note this URL must be routable from inside the container
# so `localhost` will most likely not work
OPENAEV_URL=ChangeMe
# admin account API token from the OpenAEV server
OPENAEV_TOKEN=ChangeMe
# only required for multi-tenancy (Enterprise Edition), keep commented otherwise
#OPENAEV_TENANT_ID=ChangeMe

# collector ID must be a unique string, e.g. UUIDv4
COLLECTOR_ID=ChangeMe
COLLECTOR_NAME=Splunk ES
COLLECTOR_PLATFORM=SIEM
COLLECTOR_PERIOD=PT1M
COLLECTOR_LOG_LEVEL=error

SPLUNK_ES_BASE_URL=ChangeMe
# Authentication: a Splunk authentication token of a dedicated, least-privilege
# service account (preferred, see README "Required permissions"), sent as a
# Bearer token. When it is set, SPLUNK_ES_USERNAME/SPLUNK_ES_PASSWORD are ignored.
SPLUNK_ES_TOKEN=ChangeMe
# Or, without a token, basic authentication of the same service account:
# SPLUNK_ES_USERNAME=ChangeMe
# SPLUNK_ES_PASSWORD=ChangeMe
# SPLUNK_ES_ALERTS_INDEX="notable"
# SPLUNK_ES_TIME_WINDOW=PT1H
# SPLUNK_ES_MAX_RETRY=5
# SPLUNK_ES_OFFSET=PT2M
# time after the recorded end date before an unmatched detection expectation is marked Not Detected (ISO 8601) - without an end date, the start date is used with a factor 1.5
# SPLUNK_ES_RETRY_WINDOW=PT20M
# LOGGING expectations: search raw-event indexes (not the notable index).
# Off by default; the indexes are required when it is on.
# SPLUNK_ES_LOGGING_ENABLED=true
# SPLUNK_ES_LOGGING_INDEXES=sysmon,wineventlog
# Optional: replace the built-in Logging search (leave empty to keep it). Must include '| table _time, index, _raw'.
# SPLUNK_ES_LOGGING_QUERY_TEMPLATE=search index IN ({indexes}) sourcetype=XmlWinEventLog* earliest={earliest} latest={latest} ({terms}) | table _time, index, host, sourcetype, _raw
# Longest time between two Logging searches of the same expectation (at most PT1H)
# SPLUNK_ES_LOGGING_MAX_INTERVAL=PT15M
# SPLUNK_ES_QUERY_TEMPLATE=index={alerts_index} (src_ip IN ({source_ips}) OR src IN ({source_ips}) OR source_ip IN ({source_ips}) OR client_ip IN ({source_ips})) (dst_ip IN ({target_ips}) OR dest IN ({target_ips}) OR dest_ip IN ({target_ips}) OR destination_ip IN ({target_ips}) OR server_ip IN ({target_ips})) (host IN ({hostnames}) OR hostname IN ({hostnames}) OR host_name IN ({hostnames})) earliest={start_date} latest={end_date} | table _time, src_ip, src, source_ip, client_ip, dst_ip, dest, dest_ip, destination_ip, server_ip, host, hostname, signature, rule_name, event_type, severity, url_path, _raw | sort -_time
