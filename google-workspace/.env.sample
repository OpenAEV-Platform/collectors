### More env vars are defined in the example docker-compose.yml file
### with appropriate defaults.

# base URL to reach the OpenAEV server
# note this URL must be routable from inside the container
# so `localhost` will most likely not work
OPENAEV_URL=ChangeMe
# admin account API token from the OpenAEV server
OPENAEV_TOKEN=ChangeMe
# only required for multi-tenancy (Enterprise Edition), keep commented otherwise
#OPENAEV_TENANT_ID=ChangeMe

# collector ID must be a unique string, e.g. UUIDv4
COLLECTOR_ID=ChangeMe
COLLECTOR_NAME=Google Workspace
COLLECTOR_PERIOD=PT1H
COLLECTOR_LOG_LEVEL=error

COLLECTOR_GOOGLE_WORKSPACE_DELEGATED_ADMIN_EMAIL=ChangeMe
COLLECTOR_GOOGLE_WORKSPACE_CUSTOMER_ID=my_customer
COLLECTOR_INCLUDE_SUSPENDED=false
COLLECTOR_SYNC_ALL_USERS=false

# Default authentication: the downloaded service account JSON key.
COLLECTOR_GOOGLE_WORKSPACE_AUTH_TYPE=service_account_json
COLLECTOR_GOOGLE_WORKSPACE_SERVICE_ACCOUNT_JSON=ChangeMe

# Alternative authentication: sign the JWT-bearer assertion yourself with a
# private key/certificate pair you generate and register as an external key
# for the service account, instead of handing Google-issued JSON key
# material to this collector. Uncomment and fill these in, set
# COLLECTOR_GOOGLE_WORKSPACE_AUTH_TYPE=certificate, and leave
# COLLECTOR_GOOGLE_WORKSPACE_SERVICE_ACCOUNT_JSON unset.
#COLLECTOR_GOOGLE_WORKSPACE_CLIENT_EMAIL=ChangeMe
#COLLECTOR_GOOGLE_WORKSPACE_CLIENT_CERTIFICATE=ChangeMe
#COLLECTOR_GOOGLE_WORKSPACE_CLIENT_PRIVATE_KEY=ChangeMe
#COLLECTOR_GOOGLE_WORKSPACE_CLIENT_PRIVATE_KEY_ID=ChangeMe
#COLLECTOR_GOOGLE_WORKSPACE_TOKEN_URI=https://oauth2.googleapis.com/token
