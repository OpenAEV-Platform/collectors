### More env vars are defined in the example docker-compose.yml file
### with appropriate defaults.

# base URL to reach the OpenAEV server
# note this URL must be routable from inside the container
# so `localhost` will most likely not work
OPENAEV_URL=ChangeMe
# admin account API token from the OpenAEV server
OPENAEV_TOKEN=ChangeMe
# only required for multi-tenancy (Enterprise Edition), keep commented otherwise
#OPENAEV_TENANT_ID=ChangeMe

# collector ID must be a unique string, e.g. UUIDv4
COLLECTOR_ID=ChangeMe
COLLECTOR_NAME=OVHcloud
COLLECTOR_PERIOD=PT1H
COLLECTOR_LOG_LEVEL=error

# API endpoint: ovh-eu, ovh-ca or ovh-us
COLLECTOR_OVHCLOUD_ENDPOINT=ovh-eu
# Either application key + application secret + consumer key...
COLLECTOR_OVHCLOUD_APPLICATION_KEY=ChangeMe
COLLECTOR_OVHCLOUD_APPLICATION_SECRET=ChangeMe
COLLECTOR_OVHCLOUD_CONSUMER_KEY=ChangeMe
# ... or an OAuth2 service account (leave the three keys above unset)
#COLLECTOR_OVHCLOUD_CLIENT_ID=ChangeMe
#COLLECTOR_OVHCLOUD_CLIENT_SECRET=ChangeMe

# What to collect
COLLECTOR_OVHCLOUD_COLLECT_DEDICATED_SERVERS=true
COLLECTOR_OVHCLOUD_COLLECT_PUBLIC_CLOUD=false
COLLECTOR_OVHCLOUD_COLLECT_VPS=false
COLLECTOR_OVHCLOUD_COLLECT_HOSTED_PRIVATE_CLOUD=false

# Filters (all optional)
#COLLECTOR_OVHCLOUD_PUBLIC_CLOUD_PROJECT_IDS=
#COLLECTOR_OVHCLOUD_REGIONS=
#COLLECTOR_OVHCLOUD_NAME_INCLUDE=
#COLLECTOR_OVHCLOUD_NAME_EXCLUDE=
#COLLECTOR_OVHCLOUD_IAM_TAGS=
COLLECTOR_OVHCLOUD_SKIP_INACTIVE=true

# IP addresses
COLLECTOR_OVHCLOUD_INCLUDE_PUBLIC_IPV4=true
COLLECTOR_OVHCLOUD_INCLUDE_PUBLIC_IPV6=true
COLLECTOR_OVHCLOUD_INCLUDE_PRIVATE_IPS=true

# Tagging and tuning
COLLECTOR_OVHCLOUD_IMPORT_TAGS=true
COLLECTOR_OVHCLOUD_MAX_WORKERS=5
