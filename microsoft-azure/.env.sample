### More env vars are defined in the example docker-compose.yml file
### with appropriate defaults.

# base URL to reach the OpenAEV server
# note this URL must be routable from inside the container
# so `localhost` will most likely not work
OPENAEV_URL=ChangeMe
# admin account API token from the OpenAEV server
OPENAEV_TOKEN=ChangeMe
# only required for multi-tenancy (Enterprise Edition), keep commented otherwise
#OPENAEV_TENANT_ID=ChangeMe

# collector ID must be a unique string, e.g. UUIDv4
COLLECTOR_ID=ChangeMe
COLLECTOR_NAME=Microsoft Azure
COLLECTOR_PERIOD=PT1H
COLLECTOR_LOG_LEVEL=error

COLLECTOR_MICROSOFT_AZURE_TENANT_ID=ChangeMe
COLLECTOR_MICROSOFT_AZURE_CLIENT_ID=ChangeMe
# Authentication: client secret (default) or client certificate.
# Keep the default (client secret) unless you registered a certificate on the Entra ID
# application.
COLLECTOR_MICROSOFT_AZURE_CLIENT_SECRET=ChangeMe
# Set to true to authenticate with a client certificate instead of a client secret.
#COLLECTOR_MICROSOFT_AZURE_USE_CERTIFICATE_AUTH=false
# PEM encoded private key of the certificate (newlines escaped as \n).
#COLLECTOR_MICROSOFT_AZURE_CLIENT_CERT_DATA=ChangeMe
# SHA-1 thumbprint of the certificate registered on the Entra ID application.
#COLLECTOR_MICROSOFT_AZURE_CLIENT_CERT_THUMBPRINT=ChangeMe
# Only required when the private key above is encrypted.
#COLLECTOR_MICROSOFT_AZURE_CLIENT_CERT_PASSPHRASE=ChangeMe
COLLECTOR_MICROSOFT_AZURE_SUBSCRIPTION_ID=ChangeMe
COLLECTOR_MICROSOFT_AZURE_RESOURCE_GROUPS=ChangeMe
