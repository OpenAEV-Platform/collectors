openaev:
  url: 'http://localhost:8080'
  token: 'ChangeMe'
  # only required for multi-tenancy (Enterprise Edition), keep commented otherwise
  # tenant_id: 'ChangeMe'

collector:
  id: 'ChangeMe'
  name: 'CrowdStrike Endpoint Security'
  platform: 'EDR'
  period: 'PT1M'
  log_level: 'error'

crowdstrike:
  api_base_url: 'https://api.us-2.crowdstrike.com'
  ui_base_url: 'https://falcon.us-2.crowdstrike.com'
  client_id: 'ChangeMe'
  client_secret: 'ChangeMe'
  # or read the credentials from files written by a secrets store (see README)
  # client_id_file: '/run/secrets/crowdstrike_client_id'
  # client_secret_file: '/run/secrets/crowdstrike_client_secret'
