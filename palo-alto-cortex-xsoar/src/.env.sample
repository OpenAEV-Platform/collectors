### Copy this file to .env next to docker-compose.yml, which passes it to the
### collector as is. Settings left out keep the collector's defaults.

# base URL to reach the OpenAEV server
# note this URL must be routable from inside the container
# so `localhost` will most likely not work
OPENAEV_URL=ChangeMe
# admin account API token from the OpenAEV server
OPENAEV_TOKEN=ChangeMe

# collector ID must be a unique string, e.g. UUIDv4
COLLECTOR_ID=ChangeMe
COLLECTOR_NAME=Palo Alto Cortex XSOAR
COLLECTOR_PLATFORM=EDR
COLLECTOR_PERIOD=PT2M
COLLECTOR_LOG_LEVEL=error

# Cortex XSOAR tenant API URL
PALO_ALTO_CORTEX_XSOAR_API_URL=https://ChangeMe
PALO_ALTO_CORTEX_XSOAR_API_KEY=ChangeMe
# numeric API key ID
PALO_ALTO_CORTEX_XSOAR_API_KEY_ID=ChangeMe
# standard or advanced
# PALO_ALTO_CORTEX_XSOAR_API_KEY_TYPE=standard
# search window when no date signatures are provided (ISO 8601 format)
# PALO_ALTO_CORTEX_XSOAR_TIME_WINDOW=PT1H
