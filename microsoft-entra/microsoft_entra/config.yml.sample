openaev:
  url: 'http://localhost:3001'
  token: 'ChangeMe'
  # only required for multi-tenancy (Enterprise Edition), keep commented otherwise
  # tenant_id: 'ChangeMe'

collector:
  id: 'ChangeMe'
  name: 'Microsoft Entra'
  period: 'PT1H'
  log_level: 'error'
  microsoft_entra_tenant_id: ''
  microsoft_entra_client_id: ''
  microsoft_entra_use_certificate_auth: false
  microsoft_entra_client_secret: ''  # required unless microsoft_entra_use_certificate_auth is true
  # required when microsoft_entra_use_certificate_auth is true
  # microsoft_entra_client_cert_data: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
  # microsoft_entra_client_cert_thumbprint: "AB12CD34EF56AB12CD34EF56AB12CD34EF56AB12"
  # optional, when the private key is encrypted
  # microsoft_entra_client_cert_passphrase: ''
  include_external: false
