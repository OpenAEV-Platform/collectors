### More env vars are defined in the example docker-compose.yml file
### with appropriate defaults.

# base URL to reach the OpenAEV server
# note this URL must be routable from inside the container
# so `localhost` will most likely not work
OPENAEV_URL=ChangeMe
# admin account API token from the OpenAEV server
OPENAEV_TOKEN=ChangeMe
# only required for multi-tenancy (Enterprise Edition), keep commented otherwise
#OPENAEV_TENANT_ID=ChangeMe

# collector ID must be a unique string, e.g. UUIDv4
COLLECTOR_ID=ChangeMe
COLLECTOR_NAME=Microsoft Entra
COLLECTOR_PERIOD=PT1H
COLLECTOR_LOG_LEVEL=error

# Microsoft Entra-specific: find these values
# in your Microsoft Entra app account settings
COLLECTOR_MICROSOFT_ENTRA_TENANT_ID=ChangeMe
COLLECTOR_MICROSOFT_ENTRA_CLIENT_ID=ChangeMe
COLLECTOR_MICROSOFT_ENTRA_USE_CERTIFICATE_AUTH=false
COLLECTOR_MICROSOFT_ENTRA_CLIENT_SECRET=ChangeMe
# required when COLLECTOR_MICROSOFT_ENTRA_USE_CERTIFICATE_AUTH=true
# COLLECTOR_MICROSOFT_ENTRA_CLIENT_CERT_DATA="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# COLLECTOR_MICROSOFT_ENTRA_CLIENT_CERT_THUMBPRINT=AB12CD34EF56AB12CD34EF56AB12CD34EF56AB12
# optional, when the private key is encrypted
# COLLECTOR_MICROSOFT_ENTRA_CLIENT_CERT_PASSPHRASE=ChangeMe
COLLECTOR_INCLUDE_EXTERNAL=false
