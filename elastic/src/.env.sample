### More env vars are defined in the example docker-compose.yml file
### with appropriate defaults.

# base URL to reach the OpenAEV server
# note this URL must be routable from inside the container
# so `localhost` will most likely not work
OPENAEV_URL=ChangeMe
# admin account API token from the OpenAEV server
OPENAEV_TOKEN=ChangeMe
# only required for multi-tenancy (Enterprise Edition), keep commented otherwise
#OPENAEV_TENANT_ID=ChangeMe

# collector ID must be a unique string, e.g. UUIDv4
COLLECTOR_ID=ChangeMe
COLLECTOR_NAME=Elastic Security
COLLECTOR_PLATFORM=SIEM
COLLECTOR_PERIOD=PT1M
COLLECTOR_LOG_LEVEL=error

ELASTIC_BASE_URL=ChangeMe
# Authentication: provide an API key (preferred) OR a username/password pair
# ELASTIC_API_KEY=ChangeMe
ELASTIC_USERNAME=ChangeMe
ELASTIC_PASSWORD=ChangeMe
ELASTIC_ALERTS_INDEX=.alerts-security.alerts-*
# Optional: editable Lucene query_string used to fetch and correlate alerts.
# Leave unset to use the built-in default. Placeholders (each list is rendered
# as an OR-joined, quoted set): {source_ips} {target_ips} {implant_urls}
# {implant_names} {start_date} {end_date} {time_window} {alerts_index}.
# ELASTIC_QUERY_TEMPLATE=
# Optional: raw endpoint/process events index used by the source-event
# drilldown to recover the OpenAEV implant marker (deterministic per-inject
# correlation). Set empty to disable the drilldown (IP + time only).
# ELASTIC_EVENTS_INDEX=logs-windows.sysmon_operational-*,logs-endpoint.events.process-*
# Optional Kibana base URL for trace links.
# When unset, base_url is reused with its port rewritten to 5601.
# ELASTIC_KIBANA_URL=https://kibana.company.com:5601
# Optional CA bundle path to verify a self-signed cluster instead of disabling
# TLS verification (recommended over ELASTIC_VERIFY_SSL=false; overrides it).
# ELASTIC_CA_CERT=/etc/ssl/certs/elastic-ca.pem
