### Copy this file to .env next to docker-compose.yml, which reads the
### collector settings from it. Settings left out keep the collector's defaults.

# base URL to reach the OpenAEV server
# note this URL must be routable from inside the container
# so `localhost` will most likely not work
OPENAEV_URL=ChangeMe
# admin account API token from the OpenAEV server
OPENAEV_TOKEN=ChangeMe
# only required for multi-tenancy (Enterprise Edition), keep commented otherwise
#OPENAEV_TENANT_ID=ChangeMe

# collector ID must be a unique string, e.g. UUIDv4
COLLECTOR_ID=ChangeMe
COLLECTOR_NAME=Elastic Security
COLLECTOR_PLATFORM=SIEM
COLLECTOR_PERIOD=PT1M
COLLECTOR_LOG_LEVEL=error

ELASTIC_BASE_URL=ChangeMe
# Authentication: provide an API key (preferred) OR a username/password pair
# OR (self-managed / ECK only) a client certificate and key for the PKI realm.
# Optionally pin the method (API_KEY, USER_PASSWORD or PKI); the settings of the
# other methods are then ignored. Unset = inferred.
# ELASTIC_AUTHENTICATION_TYPE=USER_PASSWORD
# ELASTIC_API_KEY=ChangeMe
ELASTIC_USERNAME=ChangeMe
ELASTIC_PASSWORD=ChangeMe
# PKI: certificate and unencrypted key as BASE64-ENCODED PEM files (not paths,
# not raw PEM), e.g. the output of `base64 -w0 client.crt` / `base64 -w0 client.key`
# ELASTIC_CLIENT_CERT=ChangeMe
# ELASTIC_CLIENT_KEY=ChangeMe
ELASTIC_ALERTS_INDEX=.alerts-security.alerts-*
# Optional: editable Lucene query_string used to fetch the candidate alerts.
# Leave unset or empty to use the built-in default, shown below: uncomment and
# edit it on a single line, unquoted or wrapped in single quotes. With Docker
# Compose, write $$ for a literal $ and avoid " #" (read as a comment).
# Placeholders (each list is rendered as an OR-joined, quoted set):
# {source_ips} {target_ips} {implant_urls} {implant_names} {start_date}
# {end_date} {time_window} {alerts_index}. The @timestamp range is added
# separately. Read at startup: apply a change with `docker compose up -d`
# (`docker compose restart` keeps the old values). See README "Customizing the
# alert query" for examples.
# ELASTIC_QUERY_TEMPLATE=(source.ip:({source_ips}) OR host.ip:({source_ips}) OR client.ip:({source_ips})) OR (destination.ip:({target_ips}) OR server.ip:({target_ips}) OR host.ip:({target_ips})) OR (url.path:({implant_urls}) OR url.original:({implant_urls})) OR (process.name:({implant_names}) OR process.parent.name:({implant_names}) OR process.command_line:({implant_names}))
# Optional: raw endpoint/process events index used by the source-event
# drilldown to recover the OpenAEV implant marker (deterministic per-inject
# correlation). Defaults to Sysmon, Elastic Defend and the Windows Security
# channel (event 4688); a host with no process-creation event there is
# correlated on IP + time. Set empty to disable the drilldown (IP + time only).
# ELASTIC_EVENTS_INDEX=logs-windows.sysmon_operational-*,logs-endpoint.events.process-*,logs-system.security-*
# Optional Kibana base URL for trace links.
# When unset, base_url is reused with its port rewritten to 5601.
# ELASTIC_KIBANA_URL=https://kibana.company.com:5601
# Optional CA bundle path to verify a self-signed cluster instead of disabling
# TLS verification (recommended over ELASTIC_VERIFY_SSL=false; overrides it).
# With Docker, mount the bundle first (see the volumes example in
# docker-compose.yml).
# ELASTIC_CA_CERT=/certs/ca.pem
# Lab only: disable TLS verification (exposes credentials to interception).
# ELASTIC_VERIFY_SSL=false
