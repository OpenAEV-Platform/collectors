openaev:
  url: "http://change.me"
  token: "ChangeMe"
  # only required for multi-tenancy (Enterprise Edition), keep commented otherwise
  # tenant_id: "ChangeMe"

collector:
  id: "ChangeMe"
  name: 'Elastic Security'
  platform: 'SIEM'
  period: 'PT1M'
  log_level: 'error'

elastic:
  base_url: "https://elastic.company.com:9200"
  # Authentication: API_KEY (preferred), PASSWORD (basic auth) or PKI
  # (client certificate, self-managed Elasticsearch/ECK only). When unset,
  # it is inferred from the credentials below.
  auth_type: "PASSWORD"
  # api_key: "ChangeMe"
  username: "ChangeMe"
  password: "ChangeMe"
  # client_cert: "/path/to/client.crt"
  # client_key: "/path/to/client.key"
  # ca_cert: "/path/to/ca.crt"
  alerts_index: ".alerts-security.alerts-*"
  # kibana_url: "https://kibana.company.com:5601"
  verify_ssl: true
  time_window: "PT1H"
  offset: "PT30S"
  max_retry: 3
