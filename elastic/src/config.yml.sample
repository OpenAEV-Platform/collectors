openaev:
  url: "http://change.me"
  token: "ChangeMe"
  # only required for multi-tenancy (Enterprise Edition), keep commented otherwise
  # tenant_id: "ChangeMe"

collector:
  id: "ChangeMe"
  name: 'Elastic Security'
  platform: 'SIEM'
  period: 'PT1M'
  log_level: 'error'

elastic:
  base_url: "https://elastic.company.com:9200"
  # Authentication: provide an API key (preferred) OR a username/password pair
  # OR (self-managed / ECK only) a client certificate and key for the PKI realm.
  # Optionally pin the method (API_KEY, USER_PASSWORD or PKI); the settings of
  # the other methods must then be left unset. Unset = inferred.
  # authentication_type: "USER_PASSWORD"
  # api_key: "ChangeMe"
  username: "ChangeMe"
  password: "ChangeMe"
  # PKI: certificate and unencrypted key as BASE64-ENCODED PEM files (not
  # paths, not raw PEM), e.g. `base64 -w0 client.crt` / `base64 -w0 client.key`.
  # client_cert: "ChangeMe"
  # client_key: "ChangeMe"
  alerts_index: ".alerts-security.alerts-*"
  # Optional editable Lucene query_string (unset = built-in default).
  # Placeholders: {source_ips} {target_ips} {implant_urls} {implant_names}
  # {start_date} {end_date} {time_window} {alerts_index}.
  # query_template: ""
  # Raw endpoint/process events index for the implant-marker drilldown
  # (empty string disables the drilldown -> IP + time correlation only).
  events_index: "logs-windows.sysmon_operational-*,logs-endpoint.events.process-*"
  # kibana_url: "https://kibana.company.com:5601"
  verify_ssl: true
  # Optional CA bundle to verify a self-signed cluster instead of disabling
  # verification (recommended over verify_ssl: false). Overrides verify_ssl.
  # ca_cert: "/etc/ssl/certs/elastic-ca.pem"
  time_window: "PT1H"
  offset: "PT30S"
  max_retry: 3
