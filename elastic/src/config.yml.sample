openaev:
  url: "http://change.me"
  token: "ChangeMe"
  # only required for multi-tenancy (Enterprise Edition), keep commented otherwise
  # tenant_id: "ChangeMe"

collector:
  id: "ChangeMe"
  name: 'Elastic Security'
  platform: 'SIEM'
  period: 'PT1M'
  log_level: 'error'

elastic:
  base_url: "https://elastic.company.com:9200"
  # Authentication: provide an API key (preferred) OR a username/password pair
  # OR (self-managed / ECK only) a client certificate and key for the PKI realm.
  # Optionally pin the method (API_KEY, USER_PASSWORD or PKI); the settings of
  # the other methods are then ignored. Unset = inferred.
  # authentication_type: "USER_PASSWORD"
  # api_key: "ChangeMe"
  username: "ChangeMe"
  password: "ChangeMe"
  # PKI: certificate and unencrypted key as BASE64-ENCODED PEM files (not
  # paths, not raw PEM), e.g. `base64 -w0 client.crt` / `base64 -w0 client.key`.
  # client_cert: "ChangeMe"
  # client_key: "ChangeMe"
  alerts_index: ".alerts-security.alerts-*"
  # Optional editable Lucene query_string used to fetch the candidate alerts
  # (unset = built-in default, shown below). Placeholders: {source_ips}
  # {target_ips} {implant_urls} {implant_names} {start_date} {end_date}
  # {time_window} {alerts_index}. The @timestamp range is added separately.
  # See README "Customizing the alert query" for examples.
  # query_template: '(source.ip:({source_ips}) OR host.ip:({source_ips}) OR client.ip:({source_ips})) OR (destination.ip:({target_ips}) OR server.ip:({target_ips}) OR host.ip:({target_ips})) OR (url.path:({implant_urls}) OR url.original:({implant_urls})) OR (process.name:({implant_names}) OR process.parent.name:({implant_names}) OR process.command_line:({implant_names}))'
  # Raw endpoint/process events index for the implant-marker drilldown:
  # Sysmon, Elastic Defend and the Windows Security channel (event 4688). A
  # host with no process-creation event there is correlated on IP + time.
  # (empty string disables the drilldown -> IP + time correlation only).
  events_index: "logs-windows.sysmon_operational-*,logs-endpoint.events.process-*,logs-system.security-*"
  # kibana_url: "https://kibana.company.com:5601"
  verify_ssl: true
  # Optional CA bundle to verify a self-signed cluster instead of disabling
  # verification (recommended over verify_ssl: false). Overrides verify_ssl.
  # ca_cert: "/etc/ssl/certs/elastic-ca.pem"
  time_window: "PT1H"
  offset: "PT30S"
  max_retry: 3
