# Parameters of the Elasticsearch integration tests (tests_integration/).
# Copy this file to integration_test.env (git-ignored) in the same directory and
# fill it in. Only this file is read: exported shell variables are ignored.
# Relative paths are resolved from this directory.

# Endpoint every test sends its GET to. /_security/_authenticate answers 200 to
# any authenticated identity, so the result does not depend on index privileges.
ELASTIC_SEARCH_URL=https://localhost:9200/_security/_authenticate
# CA certificate that signed the cluster HTTP certificate, used to verify it.
CA_CERT_PATH=changeme/ca.crt

# USER_PASSWORD: HTTP basic authentication.
ELASTIC_USER=elastic
ELASTIC_PASSWORD=changeme

# API_KEY: the encoded key (base64 of "id:api_key") returned by the create API key API.
ELASTIC_API_KEY=changeme

# PKI: client certificate signed by a CA the PKI realm trusts, and its private key.
ELASTIC_CERT_PATH=../src/pki/pki-client.crt
ELASTIC_KEY_PATH=../src/pki/pki-client.key
