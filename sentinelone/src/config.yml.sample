openaev:
  url: "http://change.me"
  token: "ChangeMe"
  # only required for multi-tenancy (Enterprise Edition), keep commented otherwise
  # tenant_id: "ChangeMe"

collector:
  id: "ChangeMe"
  name: 'SentinelOne'
  platform: 'EDR'
  period: 'PT2M'
  log_level: 'error'

sentinelone:
  base_url: "http://change.me"
  api_key: "ChangeMe"
  # LOGGING expectations: search raw events for the inject's activity.
  # Off by default. Needs enable_deep_visibility_search: true too.
  # enable_deep_visibility_search: true
  # logging_enabled: true
  # Longest time between two Logging searches of the same expectation (at most
  # PT1H). Searches start every collector period and back off while nothing is found.
  # logging_max_interval: 'PT15M'
